{
  "name": "@crewbie/cli",
  "version": "0.1.0-alpha.18",
  "description": "A repository-aware AI implementation crew for existing and greenfield projects.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mvanderbend-msoft/crewbie.git"
  },
  "homepage": "https://github.com/mvanderbend-msoft/crewbie#readme",
  "bugs": {
    "url": "https://github.com/mvanderbend-msoft/crewbie/issues"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org"
  },
  "type": "module",
  "bin": {
    "crewbie": "dist/cli.js"
  },
  "files": [
    "dist",
    "docs",
    "examples",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "npm run build && node --test test/*.test.mjs",
    "check": "tsc -p tsconfig.json --noEmit",
    "prepack": "npm run build"
  },
  "dependencies": {
    "@github/copilot-sdk": "1.0.14",
    "@inquirer/prompts": "^7.10.1",
    "jsonc-parser": "^3.3.1",
    "string-width": "^7.2.0",
    "yaml": "^2.8.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "jsdom": "^26.1.0",
    "typescript": "^5.9.0"
  }
}
